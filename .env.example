# =============================================================================
# SISTRA-TEC Backend - Variables de Entorno (PLANTILLA)
# =============================================================================
# Copie este archivo a .env.development o .env.production y ajuste los valores.
# NUNCA suba archivos .env reales al repositorio.

# Entorno: development | production | test
NODE_ENV=development

# Puerto en el que corre el servidor HTTP
PORT=3000

# Versión de la API (se prefija en todas las rutas: /api/v1/...)
API_VERSION=v1

# -----------------------------------------------------------------------------
# Base de datos PostgreSQL (Neon)
# -----------------------------------------------------------------------------
# Formato: postgresql://usuario:password@host/basedatos?sslmode=require
DATABASE_URL=postgresql://usuario:password@ep-xxx.aws.neon.tech/sistratec?sslmode=require

# -----------------------------------------------------------------------------
# Autenticación JWT
# -----------------------------------------------------------------------------
# Secretos LARGOS (mínimo 32 caracteres aleatorios). Genere con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=reemplazar_por_secreto_largo_y_aleatorio_de_al_menos_32_caracteres
JWT_EXPIRES_IN=15m

JWT_REFRESH_SECRET=reemplazar_por_otro_secreto_largo_y_distinto_del_anterior
JWT_REFRESH_EXPIRES_IN=7d

# Rondas de hashing bcrypt. 10 = rápido en dev, 12 = recomendado en producción.
BCRYPT_ROUNDS=10

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
# Orígenes permitidos separados por coma. Use * solo en desarrollo.
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
